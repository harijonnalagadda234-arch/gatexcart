SECRET_KEY=change-this-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=gatexkart_db
DB_USER=root
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
# Optional CA bundle override for remote MySQL/TiDB TLS connections.
# By default, remote hosts use certs/isrgrootx1.pem with certificate verification.
# DB_SSL_CA=certs/isrgrootx1.pem
# For production, set DEBUG=False, a strong SECRET_KEY, ALLOWED_HOSTS, and
# CSRF_TRUSTED_ORIGINS (full https:// origins for custom domains).
